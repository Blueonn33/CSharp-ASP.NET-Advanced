@model ErrorViewModel
@{
    int statusCode = ViewData["StatusCode"] is int code ? code : 500;
    var error = statusCode switch
    {
        400 => (Title: "Bad Request", Message: "The request could not be understood. Please check it and try again.", Icon: "bi-exclamation-triangle"),
        404 => (Title: "Page Not Found", Message: "We couldn't find the page you're looking for. It may have moved or no longer exists.", Icon: "bi-search"),
        500 => (Title: "Internal Server Error", Message: "Something went wrong on our end. Please try again later.", Icon: "bi-wrench-adjustable-circle"),
        _ => (Title: "An Error Occurred", Message: "We couldn't complete your request. Please try again.", Icon: "bi-exclamation-circle")
    };
    ViewData["Title"] = $"{statusCode} - {error.Title}";
}

<section class="error-page text-center" aria-labelledby="error-title">
    <div class="error-icon" aria-hidden="true">
        <i class="bi @error.Icon"></i>
    </div>
    <p class="error-code">@statusCode</p>
    <h1 id="error-title" class="error-title">@error.Title</h1>
    <p class="error-message">@error.Message</p>

    @if (statusCode == 500 && Model.ShowRequestId)
    {
        <p class="error-request-id">Reference ID: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-warning error-home-link" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house-door-fill"></i> Return to Home
    </a>
</section>
